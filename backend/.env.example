# ============================================================
# AEGIS-AI Backend -- Environment Variables
# ============================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.
# ============================================================

# -- IBM Watsonx AI credentials ---------------------------------
# Required for the AI threat analysis to function.

# IAM API key from IBM Cloud (https://cloud.ibm.com/iam/apikeys)
IBM_WATSONX_API_KEY=your_ibm_watsonx_api_key_here

# Service URL for your IBM Watsonx region
# US South:   https://us-south.ml.cloud.ibm.com
# EU DE:      https://eu-de.ml.cloud.ibm.com
# AU SYD:     https://au-syd.ml.cloud.ibm.com
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Project ID from your IBM Watsonx project settings
IBM_WATSONX_PROJECT_ID=your_project_id_here

# Model to use (default is IBM Granite 3.8B Instruct)
# Other options: ibm/granite-3-2b-instruct  ibm/granite-13b-instruct-v2
IBM_WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# -- Server configuration ----------------------------------------

# Port for the Flask server (default: 5000; Render sets this automatically)
PORT=5000

# Enable Flask debug mode -- set to false in production
FLASK_DEBUG=false

# -- CORS --------------------------------------------------------
# Allowed origins for cross-origin requests.
# For production, set to your exact frontend URL:
CORS_ORIGINS=https://aegisai-frontend.onrender.com
